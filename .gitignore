# ---- IDE / OS ----
.idea/
.vscode/
*.code-workspace
.gitpod.yml
.DS_Store
.tactility/
.caveman.json
.ai/mcp
.clinerules/

# ---- build outputs & CMake caches (regenerated by idf.py build) ----
build*/
!.github/actions/build*/
cmake*/
CMakeCache.txt
*.cbp
CMakeFiles

# ---- ESP-IDF managed components (re-fetched from dependencies.lock by idf.py) ----
managed_components/

# ---- Python caches ----
__pycache__
*.pyc
.pytest_cache/

# ---- generic release dir, BUT keep the player-toolkit release archive: it is embedded into the
#      firmware (source/ot/net/ToolkitZip.cpp is generated from it) and integrity-tested, so it must
#      be committed and distributed with the repo. ----
release/
!Devices/vanguard/tools/sysrupt/release/
!Devices/vanguard/tools/sysrupt/release/**

# ---- board-specific dev overrides only (the base sdkconfig below is committed for reproducibility) ----
sdkconfig.old
sdkconfig.board.*.dev

# NOTE: `sdkconfig` and `dependencies.lock` are intentionally NOT ignored here. This project has no
# `sdkconfig.defaults`, so the committed `sdkconfig` is what makes the firmware build reproducible; and
# `dependencies.lock` pins the exact managed-component versions. Commit both. (See docs for details.)
